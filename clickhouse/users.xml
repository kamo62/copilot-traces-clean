<clickhouse>
  <profiles>
    <default>
      <max_threads>2</max_threads>
      <!-- Membership verification and export pages need ~260-300 MiB on wide
           records; keep the deployed per-query limit. -->
      <max_memory_usage>536870912</max_memory_usage>
      <!-- Collector, API and optional serial worker share the copilot user. -->
      <max_memory_usage_for_user>536870912</max_memory_usage_for_user>
      <!-- No queue at the user level: a query over the limit fails at once (202).
           API, collector, worker, health checks and operator reads share it. -->
      <max_concurrent_queries_for_user>8</max_concurrent_queries_for_user>
      <!-- Free a read's slot when its HTTP client goes away. The app marks its
           SELECTs readonly=2 (clickhouse.rows), which this setting requires. -->
      <cancel_http_readonly_queries_on_client_close>1</cancel_http_readonly_queries_on_client_close>
      <max_block_size>1024</max_block_size>
      <max_insert_threads>1</max_insert_threads>
      <min_insert_block_size_bytes>8388608</min_insert_block_size_bytes>
      <log_queries>0</log_queries>
      <log_query_threads>0</log_query_threads>
    </default>
  </profiles>
</clickhouse>
